# ==============================================================================
# OmniPitch - Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit actual secrets to version control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Microsoft Foundry / Azure AI Services
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/
AZURE_AI_FOUNDRY_API_KEY=your_azure_ai_foundry_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure Event Hubs (Event-Driven Pipeline)
AZURE_EVENT_HUB_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=...
AZURE_EVENT_HUB_NAME=match-events

# Azure Storage / Cosmos DB (Match State & Historical Analytics)
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your_cosmos_primary_key_here
AZURE_COSMOS_DATABASE_NAME=omnipitch
AZURE_COSMOS_CONTAINER_NAME=matches

# Microsoft Fabric / Analytics Lakehouse (Optional integration)
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=

# Application Insights / OpenTelemetry Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=...

# Simulation Defaults
SIMULATION_DEFAULT_SEED=42
SIMULATION_TICK_RATE_MS=500
